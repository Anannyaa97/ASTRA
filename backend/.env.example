# Copy to .env and edit. Never commit .env.
DATABASE_URL=sqlite:///./astra.db
# Origins allowed to call the API (comma separated). Add your Vercel URL after deploying.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# NASA API key (used from Phase 4). DEMO_KEY works but is heavily rate limited.
NASA_API_KEY=DEMO_KEY
# DONKI web service address. Official since 30 Sep 2026; only change it if NASA moves it again.
# DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI-API/get
